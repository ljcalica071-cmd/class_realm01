# ClassRealm Git & Linguist Configuration
# Tells GitHub that build artifacts and generated JS files are excluded from
# repository language statistics.

build/** linguist-generated=true linguist-vendored=true
build/web/** linguist-generated=true linguist-vendored=true
*.js linguist-generated=true linguist-vendored=true
*.js.map linguist-generated=true linguist-vendored=true
